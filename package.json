{
  "name": "agent-depot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:up": "docker compose up -d --wait",
    "db:status": "docker compose ps",
    "db:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:check": "tsx scripts/check-db.ts",
    "db:diagnose": "tsx scripts/diagnose-db.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "db:seed-demo": "tsx scripts/seed-demo.ts",
    "runtime:smoke": "tsx scripts/check-runtime.ts",
    "deploy:vultr": "bash scripts/deploy-vultr.sh"
    "metrics:setup": "tsx scripts/setup-runtime-metrics.ts",
    "metrics:check": "tsx scripts/check-runtime-metrics.ts",
    "metrics:test:up": "docker compose -f compose.timescale-test.yaml up -d --wait",
    "metrics:test:down": "docker compose -f compose.timescale-test.yaml down",
    "test:timescale": "tsx scripts/test-timescale.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.105",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "ai": "^7.0.153",
    "dotenv": "^18.0.9",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
