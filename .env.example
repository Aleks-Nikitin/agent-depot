# Local development only; keep password and URL consistent.
POSTGRES_PASSWORD=agent_depot_local
POSTGRES_PORT=55433
DATABASE_URL=postgresql://agent_depot:agent_depot_local@localhost:55433/agent_depot?schema=public
# Select one database for the entire application and Prisma CLI.
DATABASE_TARGET=local
TIGER_DATABASE_URL=
GOOGLE_GENERATIVE_AI_API_KEY=
# Live shopping, news and public-page extraction. Server-only; never NEXT_PUBLIC_.
SERPAPI_API_KEY=
RUNTIME_API_TOKEN=
# Disabled by default; local-only compatibility for the seeded demo workspace.
RUNTIME_ALLOW_DEMO_TOKEN=false
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Gemini 3.1 Flash-Lite standard text rates, verified 2026-10-24.
# Recheck pricing when changing models or using other modalities/service tiers.
RUNTIME_MODEL_ID=gemini-3.1-flash-lite
RUNTIME_INPUT_USD_PER_MILLION=0.25
RUNTIME_OUTPUT_USD_PER_MILLION=1.50
# Optional: enable only after metrics:setup on Tiger Cloud/TimescaleDB.
RUNTIME_METRICS_BACKEND=postgres
TIMESCALE_TEST_PORT=55434
# Optional approved fallback profile. Configure its model, key and rates together.
OPENAI_API_KEY=
OPENAI_RUNTIME_MODEL_ID=
OPENAI_RUNTIME_INPUT_USD_PER_MILLION=
OPENAI_RUNTIME_OUTPUT_USD_PER_MILLION=
# Optional metadata-only tracing. Prompts, tools and checkpoints are not exported.
LANGCHAIN_TRACING_V2=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# Recovery is bounded by the run's model-call, time and spend limits.
RUNTIME_MODEL_MAX_RETRIES=1
# Empty disables cross-provider fallback; set openai-fallback after configuring it.
RUNTIME_FALLBACK_PROFILE=
