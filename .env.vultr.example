# Copy to .env.production on the Vultr host and fill in real values.
# Keep this file secret; never commit the filled-in version.

# --- Database ---
# In-compose Postgres: host is the service name "postgres".
POSTGRES_PASSWORD=change_me_strong_password
DATABASE_URL=postgresql://agent_depot:change_me_strong_password@postgres:5432/agent_depot?schema=public

# Vultr Managed Database alternative (delete the postgres service in
# compose.prod.yaml and use the cluster connection string instead):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require

# --- Runtime auth (any string >= 24 chars) ---
RUNTIME_API_TOKEN=generate_a_long_random_token_at_least_24_chars

# --- Model (Gemini drafting / run engine) ---
GOOGLE_GENERATIVE_AI_API_KEY=
RUNTIME_MODEL_ID=gemini-3.1-flash-lite
RUNTIME_INPUT_USD_PER_MILLION=0.25
RUNTIME_OUTPUT_USD_PER_MILLION=1.50
