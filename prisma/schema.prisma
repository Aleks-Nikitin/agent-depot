generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  isAnonymous   Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum RunStatus {
  running
  waiting_approval
  completed
  blocked
  failed
}

enum ApprovalStatus {
  pending
  approved
  rejected
}

model Agent {
  id               String         @id @default(uuid())
  ownerId          String
  name             String
  version          Int            @default(1)
  config           Json
  published        Boolean        @default(false)
  publishedVersion Int?
  testRevision     Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  versions         AgentDraft[]
  releases         AgentRelease[]
  conversations    ConversationSession[]
  servingReleaseId String?
  servingGeneration Int @default(0)
  servingRelease   AgentRelease? @relation("ServingRelease", fields: [servingReleaseId], references: [id], onDelete: SetNull)
  testCases        TestCase[]     // NEW

  @@index([ownerId])
}

model AgentDraft {
  id        String   @id @default(uuid())
  agentId   String
  version   Int
  name      String
  config    Json
  createdAt DateTime @default(now())
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@map("AgentVersion")
  @@unique([agentId, version])
  @@index([agentId])
}

model AgentRun {
  workspaceSlot WorkspaceSlot?
  id             String     @id @default(uuid())
  ownerId        String
  agentId        String
  releaseId      String?
  sessionId      String?
  turn           Int?
  executionKey   String? @unique
  input          String?
  configSnapshot Json
  status         RunStatus  @default(running)
  sequence       Int        @default(0)
  version        Int        @default(0)
  checkpoint     Json?
  response       String?
  stopReason     String?
  source         String     @default("playground") // NEW: "playground" | "test"
  agentVersion   Int?                              // NEW: agent version this run used
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  finishedAt     DateTime?
  events         RunEvent[]
  approvals      Approval[]
  modelAttempts  ModelAttempt[]
  metrics        RuntimeMetric[]
  recordedEmails RecordedEmail[]

  @@index([ownerId, createdAt])
  @@index([agentId, createdAt])
  @@index([agentId, source, createdAt]) // NEW
}

// Composite key includes the partition timestamp for optional TimescaleDB use.
model RuntimeMetric {
  runId            String
  finishedAt       DateTime @db.Timestamptz(3)
  ownerId          String
  agentId          String
  agentVersion     Int
  modelProfile     String
  status           RunStatus
  stopReason       String?
  activeMs         Int
  modelCalls       Int
  toolCalls        Int
  inputTokens      Float?
  outputTokens     Float?
  estimatedCostUsd Float?
  run              AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@id([runId, finishedAt])
  @@index([ownerId, finishedAt])
  @@index([ownerId, agentId, finishedAt])
}

model RunEvent {
  eventId   String   @id @default(uuid())
  runId     String
  sequence  Int
  type      String
  payload   Json
  timestamp DateTime @default(now())
  run       AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, sequence])
}

model Approval {
  id         String         @id @default(uuid())
  runId      String
  toolCallId String
  toolId     String
  input      Json
  inputHash  String?
  status     ApprovalStatus @default(pending)
  expiresAt  DateTime
  decidedAt  DateTime?
  decidedBy  String?
  run        AgentRun       @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, toolCallId])
}

model DemoTicket {
  id             String   @id @default(uuid())
  ownerId        String
  idempotencyKey String   @unique
  subject        String
  createdAt      DateTime @default(now())
}

model KnowledgeDocument {
  id        String   @id @default(uuid())
  ownerId   String
  title     String
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, createdAt])
}

model RecordedEmail {
  id             String   @id @default(uuid())
  ownerId        String
  runId          String
  toolCallId     String
  idempotencyKey String   @unique
  to             String
  subject        String
  body           String
  createdAt      DateTime @default(now())
  run            AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([ownerId, createdAt])
}

// NEW
model TestCase {
  regressionOrigin RegressionOrigin?
  fixtures Json @default("{}")
  stateAssertions Json @default("[]")
  id          String   @id @default(uuid())
  agentId     String
  input       String
  mustCall    String[]
  mustNotCall String[]
  mustContain String[]
  useGrader   Boolean  @default(false)
  expectedBehavior String?
  source      String   @default("user") // "gemini" | "template" | "user"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
}

// NEW
model TestRun {
  jobId        String? @unique
  manifest EvaluationManifest?
  id           String   @id @default(uuid())
  agentId      String
  agentVersion Int
  results      Json     // TestResult[]
  passed       Boolean
  passedCount  Int
  totalCount   Int
  configHash   String?
  providerSettings Json?
  testsFingerprint String?
  status       String   @default("completed")
  finishedAt   DateTime?
  createdAt    DateTime @default(now())

  @@index([agentId, agentVersion, createdAt])
}

// Application receipts, separate from Graphile's vendor queue tables.
model ExecutionJob {
  id String @id @default(uuid())
  ownerId String
  agentId String
  requestKey String @unique
  requestHash String
  kind String
  payload Json
  status String @default("queued")
  runId String?
  testRunId String?
  cancelRequested Boolean @default(false)
  result Json?
  reason String?
  createdAt DateTime @default(now())
  finishedAt DateTime?
  @@index([ownerId, agentId, status])
}

// Receipt and local effect commit in the same transaction.
model LocalOperation {
  key String @id
  ownerId String
  toolId String
  inputHash String
  result Json
  createdAt DateTime @default(now())
  @@index([ownerId])
}

// One private container per owner; owner-scoped resources retain their existing IDs.
model Workspace {
  policy Json @default("{\"allowedTools\":[\"knowledge_search\",\"sales_lookup\",\"order_lookup\",\"create_ticket\",\"send_email\",\"google_shopping\",\"google_news\",\"read_webpage\"],\"dailyBudgetMicros\":1000000,\"maxConcurrentRuns\":4,\"limits\":{\"maxModelCalls\":10,\"maxWriteCalls\":5,\"maxToolCalls\":20,\"maxEstimatedCostUsd\":1,\"maxOutputTokens\":2048,\"timeoutMs\":120000}}")
  slots WorkspaceSlot[]
  days WorkspaceDay[]
  id        String   @id @default(uuid())
  ownerId   String   @unique
  name      String   @default("My workspace")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WorkspaceSlot {
  key String @id
  ownerId String
  runId String? @unique
  active Boolean @default(true)
  acquiredAt DateTime @default(now())
  workspace Workspace @relation(fields: [ownerId], references: [ownerId], onDelete: Cascade)
  run AgentRun? @relation(fields: [runId], references: [id], onDelete: Cascade)
  @@index([ownerId, active])
}

model WorkspaceDay {
  ownerId String
  day String
  heldMicros Int @default(0)
  workspace Workspace @relation(fields: [ownerId], references: [ownerId], onDelete: Cascade)
  charges WorkspaceCharge[]
  @@id([ownerId, day])
}

model WorkspaceCharge {
  key String @id
  ownerId String
  day String
  kind String
  reservedMicros Int
  chargedMicros Int
  status String @default("reserved")
  createdAt DateTime @default(now())
  bucket WorkspaceDay @relation(fields: [ownerId, day], references: [ownerId, day], onDelete: Cascade)
  @@index([ownerId, day])
}

// Provider metadata only. Private prompts and tool payloads stay in checkpoints.
model ModelAttempt {
  id              String   @id @default(uuid())
  runId           String
  attempt         Int
  modelStep       Int
  profile         String
  provider        String
  model           String
  status          String   @default("reserved")
  reservedCostUsd Float
  inputTokens     Float?
  outputTokens    Float?
  estimatedCostUsd Float?
  reason          String?
  durationMs      Int?
  startedAt       DateTime @default(now())
  finishedAt      DateTime?
  run             AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, attempt])
}

// Approval artifacts are append-only; updates are rejected by a database trigger.
model AgentRelease {
  id String @id @default(uuid())
  agentId String
  draftId String
  version Int
  config Json
  configHash String
  providerSettings Json
  evidence Json
  evidenceHash String
  approvedBy String
  createdAt DateTime @default(now())
  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  servingAgents Agent[] @relation("ServingRelease")
  @@index([agentId, createdAt])
}

model ConversationSession {
  id String @id @default(uuid())
  ownerId String
  agentId String
  draftId String
  releaseId String?
  version Int
  config Json
  providerSettings Json
  turnCount Int @default(0)
  activeRunId String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  @@index([ownerId, agentId])
}

// Owned domain orders; no external shop integration is implied.
model WorkspaceOrder {
  id String @id @default(uuid())
  ownerId String
  orderId String
  status String
  totalCents Int
  currency String @default("USD")
  createdAt DateTime @default(now())
  @@unique([ownerId, orderId])
}

model EvaluationManifest {
  testRunId String @id
  hash String
  payload Json
  createdAt DateTime @default(now())
  testRun TestRun @relation(fields: [testRunId], references: [id], onDelete: Cascade)
}

// Reviewed reproduction provenance. Runtime checkpoints are deliberately excluded.
model RegressionOrigin {
  id String @id @default(uuid())
  ownerId String
  runId String @unique
  testCaseId String @unique
  sourceHash String
  definitionHash String
  evidence Json
  createdAt DateTime @default(now())
  testCase TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  @@index([ownerId])
}
